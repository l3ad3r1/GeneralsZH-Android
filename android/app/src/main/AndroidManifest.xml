<?xml version="1.0" encoding="utf-8"?>
<!--
  GeneralsX @feature android-port 06/07/2026
  AndroidManifest.xml — the analog of ios/Stub/Info.plist.

  Key choices:
    - landscape, full-screen (the game is an RTS designed for wide screens)
    - android:largeHeap="true" (the desktop engine reaches ~3GB RSS on iOS; the
      per-process cap on Android is often lower, so request the largest heap the
      OS will grant)
    - configChanges: SDL3's SDLActivity handles orientation/keyboard/screen-size
      changes itself; without this Android recreates the Activity on every rotation
      and the Vulkan surface is torn down.
    - extractNativeLibs="false": keep .so libs page-aligned inside the APK so the
      loader mmaps them directly (smaller install, faster start).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OpenGL/Vulkan surface, audio (OpenAL/Oboe), and vibration for EVA cues. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- LAN multiplayer (mirrors NSLocalNetworkUsageDescription on iOS). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="false"
        android:label="Generals + Zero Hour"
        android:hasCode="true"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:extractNativeLibs="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
        android:icon="@mipmap/ic_launcher">

        <!--
          GeneralsX @feature android-port 08/02/2026
          LauncherActivity is the entry point: it picks the data profile and mod,
          sets the startup flags, and imports game files. It then starts
          GameActivity with the resulting argv.

          GeneralsX @tweak security 15/08/2026
          - LauncherActivity: added launchMode="singleTop" and explicit taskAffinity=""
            to guard against task hijacking (StrandHogg 2.0).
          - GameActivity: set exported="false" and taskAffinity="" so third-party apps
            cannot bypass the launcher or inject arbitrary startup extras into the native engine.

          GeneralsX @tweak security 16/08/2026
          - GameActivity: launchMode singleInstance -> singleTop. MobSF flags
            singleTask/singleInstance as a non-standard launch mode (a task-hijack
            surface); singleTop is not flagged. The single-engine-instance guarantee
            does not depend on the flag any more: the launcher starts GameActivity with
            startActivity() and no FLAG_ACTIVITY_NEW_TASK, and both activities carry
            taskAffinity="", so the game lives on top of the launcher's own task rather
            than a separate one, and there is no path that leaves a second GameActivity
            (and a second native engine + Vulkan surface) alive in the background.
        -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="Generals + Zero Hour"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|density"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:resizeableActivity="false" />

        <!--
          GeneralsX @tweak security 16/08/2026
          Strip androidx.profileinstaller.ProfileInstallReceiver, pulled in
          transitively by androidx.appcompat 1.7.0. MobSF flags it because it is
          exported and guarded only by android.permission.DUMP, whose protection
          level it cannot verify. Baseline profiles precompile Java/Kotlin bytecode
          ahead of time; this app is a native C++ engine with a thin SDLActivity
          stub, so the receiver buys effectively nothing here. Removing it at
          manifest-merge time drops both the attack surface and the finding.
        -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
