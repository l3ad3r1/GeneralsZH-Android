+          HWND                hWindow,
+    const Rc<vk::InstanceFn>& vki,
+          VkSurfaceKHR*       pSurface) {
+    SDL_Window* window = fromHwnd(hWindow);
+    return SDL_Vulkan_CreateSurface(window, vki->instance(), nullptr, pSurface)
+      ? VK_SUCCESS
+      : VK_ERROR_OUT_OF_HOST_MEMORY;
+  }
+
+}
diff --git a/src/wsi/sdl3/wsi_window_sdl3.cpp b/src/wsi/sdl3/wsi_window_sdl3.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..79dcb67b01a16719b47b95d61d0f78dde1284034
--- /dev/null
+++ b/src/wsi/sdl3/wsi_window_sdl3.cpp
@@ -0,0 +1,99 @@
+#include "../wsi_window.h"
+
+#include "wsi_helpers_sdl3.h"
+
+#include <windows.h>
+#include <wsi/native_wsi.h>
+
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+
+namespace dxvk::wsi {
+
+  void getWindowSize(
+        HWND      hWindow,
+        uint32_t* pWidth,
+        uint32_t* pHeight) {
+    int w = 0;
+    int h = 0;
+    if (!SDL_GetWindowSizeInPixels(fromHwnd(hWindow), &w, &h))
+      Logger::err(str::format("SDL3 WSI: SDL_GetWindowSizeInPixels: ", SDL_GetError()));
+
+    if (pWidth)
+      *pWidth = uint32_t(w);
+    if (pHeight)
+      *pHeight = uint32_t(h);
+  }
+
+  void resizeWindow(
+          HWND             hWindow,
+          DxvkWindowState* pState,
+          uint32_t         Width,
+          uint32_t         Height) {
+    if (!SDL_SetWindowSize(fromHwnd(hWindow), int32_t(Width), int32_t(Height)))
+      Logger::err(str::format("SDL3 WSI: SDL_SetWindowSize: ", SDL_GetError()));
+  }
+
+  bool setWindowMode(
+          HMONITOR hMonitor,
+          HWND     hWindow,
+    const WsiMode* pMode,
+          bool     EnteringFullscreen) {
+    SDL_DisplayID displayId = fromHmonitor(hMonitor);
+    if (!isDisplayValid(displayId))
+      return false;
+
+    SDL_DisplayMode closestMode = { };
+    if (!SDL_GetClosestFullscreenDisplayMode(
+          displayId, pMode->width, pMode->height,
+          float(pMode->refreshRate.numerator) / float(pMode->refreshRate.denominator),
+          true, &closestMode)) {
+      Logger::err(str::format("SDL3 WSI: SDL_GetClosestFullscreenDisplayMode: ", SDL_GetError()));
+      return false;
+    }
+
+    if (!SDL_SetWindowFullscreenMode(fromHwnd(hWindow), &closestMode)) {
+      Logger::err(str::format("SDL3 WSI: SDL_SetWindowFullscreenMode: ", SDL_GetError()));
+      return false;
+    }
+    return true;
+  }
+
+  bool enterFullscreenMode(
+          HMONITOR         hMonitor,
+          HWND             hWindow,
+          DxvkWindowState* pState,
+          bool             ModeSwitch) {
+    if (!isDisplayValid(fromHmonitor(hMonitor)))
+      return false;
+
+    if (!SDL_SetWindowFullscreen(fromHwnd(hWindow), true)) {
+      Logger::err(str::format("SDL3 WSI: SDL_SetWindowFullscreen: ", SDL_GetError()));
+      return false;
+    }
+    return true;
+  }
+
+  bool leaveFullscreenMode(
+          HWND             hWindow,
+          DxvkWindowState* pState) {
+    if (!SDL_SetWindowFullscreen(fromHwnd(hWindow), false)) {
+      Logger::err(str::format("SDL3 WSI: SDL_SetWindowFullscreen: ", SDL_GetError()));
+      return false;
+    }
+    return true;
+  }
+
+  bool restoreDisplayMode(HMONITOR hMonitor) {
+    return isDisplayValid(fromHmonitor(hMonitor));
+  }
+
+  HMONITOR getWindowMonitor(HWND hWindow) {
+    return toHmonitor(SDL_GetDisplayForWindow(fromHwnd(hWindow)));
+  }
+
+  bool isWindow(HWND hWindow) {
+    return fromHwnd(hWindow) != nullptr;
+  }
+
+}
